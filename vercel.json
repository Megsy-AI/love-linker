{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "rewrites": [
    {
      "source": "/api/deep-research",
      "destination": "/api/chat?route=deep-research"
    },
    {
      "source": "/api/dev-admin",
      "destination": "/api/manus-admin?provider=freestyle"
    },
    {
      "source": "/((?!api/|assets/|.*\\.(?:js|css|png|jpg|jpeg|webp|avif|svg|gif|ico|json|txt|xml|webmanifest|map|woff2?|ttf|otf|mp4|webm|wasm)$).*)",
      "destination": "/index.html"
    }
  ]
}
